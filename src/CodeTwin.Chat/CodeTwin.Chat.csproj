<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>code-twin-chat</AssemblyName>
    <RootNamespace>CodeTwin.Chat</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <!-- The sidecar drives the Copilot CLI the user already installed and logged in to, instead of bundling a ~250 MB runtime. -->
    <CopilotSkipCliDownload>true</CopilotSkipCliDownload>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CodeTwin.Chat.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.26" />
  </ItemGroup>
</Project>
