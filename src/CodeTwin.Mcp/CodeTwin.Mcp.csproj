<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>code-twin-mcp</AssemblyName>
    <RootNamespace>CodeTwin.Mcp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- `dotnet publish -c Release` refreshes the framework-dependent single-file exe that the twincat plugin ships. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\plugins\twincat\bin\</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CodeTwin.Mcp.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeTwin.Core\CodeTwin.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" Version="2.3.0" />
  </ItemGroup>
</Project>
